# Operator input only: nothing in the repo writes to this file. Provisioned
# resources (pod endpoint, droplet IP) live in .devbuilder/state.json.
#
# Keys excluded from the droplet's .env include provisioning credentials
# and GHCR login credentials. The GHCR PAT is sent separately over SSH
# when running make remote-ghcr-login. The rest
# are rendered into the droplet's .env by `make droplet-sync-config`
# (VPS_API_TOKEN as API_TOKEN, VLLM_ENDPOINT added from state).

# RunPod (decoder)
# RUNPOD_API_KEY: provisioning; laptop only
RUNPOD_API_KEY=rpa_XXX
# VLLM_API_KEY:   the key vLLM is started with (RunPod secret `vllm_api_key`);
#                 also synced to the droplet so the API can call the pod
VLLM_API_KEY=XXX

# DigitalOcean (VPS provisioning) - laptop only
DIGITALOCEAN_TOKEN=dop_v1_XXX
DO_SSH_KEY_FINGERPRINT=xx:...
SSH_ALLOW_CIDR=auto

# Cloudflare tunnel (public demo hostname); issued by Cloudflare on tunnel creation
TUNNEL_TOKEN=XXX
CLOUDFLARE_TAG=2026.5.0

# GHCR (container registry)
# GHCR_OWNER: namespace images live under
GHCR_OWNER=your-org-or-username
# GHCR_USER:  account you log in as (= owner for personal)
GHCR_USER=your-username
# GHCR_PAT: read:packages; excluded from the droplet's .env;
#           sent over SSH for registry login
GHCR_PAT=ghp_XXX

# API bearer auth (Authorization header on /ready, /retrieve, /ask)
# Generate with: openssl rand -hex 32
# API_TOKEN:     dev token; local containers only, never synced
API_TOKEN=XXX
# VPS_API_TOKEN: production token; synced to the droplet as API_TOKEN
VPS_API_TOKEN=XXX

# HuggingFace Hub. Optional: needed only for gated or private models. When set
# it is synced to the droplet (the export job runs there); leave empty for
# public models.
HF_TOKEN=
